# Base de datos SQLite (ruta relativa a prisma/schema.prisma)
DATABASE_URL="file:../data.nosync/comicexam.db"
# Carpeta donde se guardan cómics, miniaturas, recortes y exportaciones
DATA_DIR="./data.nosync"
# Límites de importación (en MB)
MAX_UPLOAD_MB=1024
MAX_ENTRY_MB=120
MAX_TOTAL_UNCOMPRESSED_MB=4096
MAX_ARCHIVE_ENTRIES=3000
MAX_IMAGE_MEGAPIXELS=150
NEXT_TELEMETRY_DISABLED=1
