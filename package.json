{
  "name": "comicexam-studio",
  "version": "1.0.0",
  "private": true,
  "description": "ComicExam Studio — editor visual de exámenes basados en cómics",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "setup": "playwright install chromium && tsx scripts/generate-fixtures.ts",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:pages && playwright test",
    "test:all": "vitest run && npm run build:pages && playwright test",
    "typecheck": "tsc --noEmit",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/comicexam-studio next build",
    "preview:pages": "node scripts/serve-static.mjs 3100 /comicexam-studio"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "lucide-react": "^1.64.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.3",
    "node-unrar-js": "^2.0.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "fake-indexeddb": "^6.2.8",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
